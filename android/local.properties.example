# Copy to local.properties (git-ignored) and fill in what you have. All optional.
# Android Studio also writes sdk.dir here; or set ANDROID_HOME instead.
# sdk.dir=/path/to/Android/sdk

# An application ID of your own, for installing next to someone else's build.
# polaris.applicationId=com.yourname.polaris

# A URL or address where you can be reached: TfL and Transitous ask clients to identify themselves.
# Left out, the User-Agent names the project's page; set your own if you distribute your build,
# since its requests are yours to answer for.
# polaris.contact=https://github.com/yourname

# Optional keys. Anything here is compiled into the app, where anyone with the .apk can read it.
# Restrict a Google key to the Routes API and to this app (application ID plus the SHA-1 of your
# signing certificate, which the app sends with each request; neither is secret), and set a daily
# quota cap. Keys entered in the app's settings (a later phase) will win over these.
# With a Google key set, the test screen also asks Google: up to 5 requests a search, inside the
# free monthly allowance the app counts.
# polaris.googleKey=
# polaris.tflKey=

# An alerts server of your own (worker/), as on iOS. Alerts come to Android in a later phase.
# polaris.alertsUrl=
# polaris.alertsToken=

# The map uses OpenFreeMap's public tiles unless you point it at your own OpenMapTiles-compatible
# server: a TileJSON address and a glyphs (fonts) URL template.
# polaris.mapTiles=https://tiles.openfreemap.org/planet
# polaris.mapGlyphs=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
