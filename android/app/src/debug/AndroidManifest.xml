<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a check of the map, place search and settings storage. Not the app's UI. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/debug_network">
        <!-- Shows a line alert's notice as a push would, with nothing sent or received:
             adb shell am broadcast -n <app id>/polaris.android.debug.NoticeCheckReceiver \
                 -e alert A -e title "Home to work" -e subtitle "Jubilee line: severe delays" -e body "…" -e level urgent -->
        <!-- Reachable from adb's shell only (it holds DUMP; no installed app does), so nothing else
             on a phone with a debug build can put a made-up notice in the shade. -->
        <receiver
            android:name=".debug.NoticeCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".debug.MapCheckActivity"
            android:exported="true"
            android:label="Polaris map check"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
